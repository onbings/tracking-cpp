{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tracking-cpp",
  "version": "1.0.0",
  "description": "Football tracking on moving-camera 4K video: YOLO11 (ONNX Runtime) + BoT-SORT + team, speed, ball and space analytics.",
  "license": "MIT",
  "builtin-baseline": "23b8a8e7409c2d6346114a88e834165bde79a51c",
  "vcpkg-configuration": {
    "overlay-ports": [
      "C:/pro/tracking-cpp/vcpkg-ports"
    ],
    "overlay-triplets": [
      "C:/pro/tracking-cpp/custom-triplets"
    ]
  },
  "dependencies": [
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "highgui",
        "intrinsics",
        "jpeg",
        "msmf",
        "png",
        "thread",
        "win32ui"
      ]
    },
    "onnxruntime-gpu-bin",
    "cli11",
    "nlohmann-json"
  ],
  "features": {
    "tests": {
      "description": "Build the GoogleTest unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
